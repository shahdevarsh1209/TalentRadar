NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/talentradar
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRY=30d
# Returns the verification code in the API response until a mail provider is wired up.
EXPOSE_OTP=true
OTP_TTL_MINUTES=10
OTP_RESEND_SECONDS=45
# Register/login attempts per IP per 15 minutes.
AUTH_RATE_LIMIT=20
